# Copy this file to .env on the customer's server.
# scripts/init_installation.py fills these values automatically.
COMPOSE_PROJECT_NAME=tv-telegram-control
TV_BOT_CONTAINER_NAME=tv-telegram-control
TV_BOT_UID=1000
TV_BOT_GID=1000
TV_BOT_TIMEZONE=UTC
# Comma-separated exact HTTP URLs. Leave empty when every site uses HTTPS.
TV_BOT_HTTP_ALLOWED_URLS=
